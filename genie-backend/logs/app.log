ion"},{"function":{"name":"get-stations-code-in-city","description":"通过中文城市名查询该城市 **所有** 火车站的名称及其对应的 `station_code`，结果是一个包含多个车站信息的列表。","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"type":"object","properties":{"city":{"description":"中文城市名称，例如：\"北京\", \"上海\"","type":"string"}},"required":["city"]}},"type":"function"}]}

```python
# 异常值检测函数
def detect_outliers_iqr(data, column):
    Q1 = data[column].quantile(0.25)
    Q3 = data[column].quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    outliers = data[(data[column] < lower_bound) | (data[column] > upper_bound)]
    return outliers

# 检测超市销售明细数据的异常值
sales_outliers_sales = detect_outliers_iqr(sales_data, 'total_sales')
sales_outliers_profit = detect_outliers_iqr(sales_data, 'total_profit')

# 检测商品采购信息的异常值
purchase_outliers_price = detect_outliers_iqr(purchase_data, '总采购金额')

# 输出异常值的数量
print(f"超市销售额异常值数量：{len(sales_outliers_sales)}")
print(f"超市利润异常值数量：{len(sales_outliers_profit)}")
print(f"商品采购总金额异常值数量：{len(purchase_outliers_price)}")
```

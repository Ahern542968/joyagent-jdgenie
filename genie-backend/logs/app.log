```python
# 计算销售额与利润占比
sales_data['sales_proportion'] = sales_data['total_sales'] / sales_data['total_sales'].sum()
sales_data['profit_proportion'] = sales_data['total_profit'] / sales_data['total_profit'].sum()

# 对地区计算占比和排名
region_summary['sales_proportion'] = region_summary['total_sales'] / region_summary['total_sales'].sum()
region_summary['profit_proportion'] = region_summary['total_profit'] / region_summary['total_profit'].sum()

# 保存分析洞察
df_insight = region_summary.reset_index()
insight = "分析地区销售和利润占比后发现，中南地区在销售额和利润上占比较高，而西北和西南地区占比最低。"

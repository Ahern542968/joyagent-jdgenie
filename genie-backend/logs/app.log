# 分析负利润订单在商品类别、客户和省份上的分布
negative_by_category = negative_profit_data['产品类别'].value_counts()
negative_by_customer = negative_profit_data['客户名称'].value_counts().head(10)  # Top 10 客户
negative_by_region = negative_profit_data['省/自治区'].value_counts()

# 输出结果
print("按商品类别统计的负利润订单数量：")
print(negative_by_category)

print("\n负利润订单最多的客户（Top 10）：")
print(negative_by_customer)

print("\n按省份统计的负利润订单数量：")
print(negative_by_region)
```

```python
from statsmodels.tsa.seasonal import STL

# 设置时间序列索引
df.set_index('month', inplace=True)

# 对销售额进行STL分解
stl = STL(df['total_sales'], seasonal=13)
result = stl.fit()

# 提取分解结果：趋势、季节性、残差
df['trend'] = result.trend
df['seasonal'] = result.seasonal
df['resid'] = result.resid

# 输出分解后的Top 5数据
print(f"分解结果的Top 5数据:\n{df[['total_sales', 'trend', 'seasonal', 'resid']].head()}")
```
